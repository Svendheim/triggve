desc:Triggve beta1
author:Stein
tags: drums trigger instrument
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output
options:maxmem=20000000

// ---------------------------------------------------------------------------
// Triggve beta1 - a REAPER JSFX audio-to-sample drum trigger.
// A REAPER JSFX audio-to-sample drum trigger.
//   * Transient detector: threshold, attack, release, holdoff, hysteresis
//   * 8-slot sample pool with drag & drop loading and easy unload
//   * Per-slot length / channels / sample-rate readout
//   * Slots persist in the project via @serialize
//   * 96-voice polyphonic playback
//   * Peak-accurate velocity scaling
//   * Selection modes: Single (slot 1) / Round-robin / Random (no repeat)
//   * Output Gain, wet/dry Mix, soft-clip safety ceiling, click-free stop
// ---------------------------------------------------------------------------

slider1:-18<-60,0,0.1>Threshold (dB)
slider2:1<0.1,50,0.1>Envelope Attack (ms)
slider3:5<1,45,1>Envelope Release (ms)
slider4:20<1,100,1>Retrigger Holdoff (ms)
slider5:6<0,24,1>Hysteresis (dB)
slider6:1<0,1,0.01>Mix
slider7:2<0,2,1{Single (slot 1),Round-robin,Random}>Sample Selection
slider8:0<-24,24,0.1>Output Gain (dB)

@init

// =========================================================================
// Helper functions (defined in @init so they are visible to all sections)
// =========================================================================

// Compute the memory layout. Safe to call from @init or @serialize because
// @serialize may run before @init on project load.
function setup_geometry() (
  SLOTS = 8;
  MAXLEN_SEC = 4;
  SLOT_STRIDE = (MAXLEN_SEC * srate * 2) | 0;   // stereo frames reserved per slot
  AUDIO_BASE = 0;
  META_BASE = (SLOTS * SLOT_STRIDE) | 0;

  // per-slot metadata arrays (in local memory)
  s_ok   = META_BASE;
  s_len  = META_BASE + SLOTS;      // frames
  s_nch  = META_BASE + SLOTS*2;    // 1 or 2
  s_rate = META_BASE + SLOTS*3;    // sample rate the slot was resampled to
  s_err  = META_BASE + SLOTS*4;    // load failure flag

  // ---- voice pool ----
  VOICES = 96;
  PLAY_SLOT = 0;                   // slot 1 (top-left) = "Single" selection mode
  V_BASE = META_BASE + SLOTS*5;
  v_active = V_BASE;
  v_pos    = V_BASE + VOICES;      // playhead, in frames
  v_gain   = V_BASE + VOICES*2;
  v_slot   = V_BASE + VOICES*3;
  v_age    = V_BASE + VOICES*4;    // higher = newer, for voice stealing
  v_peak   = V_BASE + VOICES*5;    // per-voice running peak while tracking
  v_track  = V_BASE + VOICES*6;    // samples left to track a voice's peak
);

setup_geometry();

// ---- GUI state -----------------------------------------------------------
prev_cap = 0;

// ---- voice engine state --------------------------------------------------
voice_age = 0;
vi = 0;
loop(VOICES, ( v_active[vi] = 0; v_track[vi] = 0; vi += 1; ));

// ---- detector state ------------------------------------------------------
env = 0;
armed = 1;
holdoff_counter = 0;
trigger = 0;
trigger_count = 0;
led = 0;
pk = 0;                  // peak follower of the current hit (for velocity)

// ---- sample-selection state --------------------------------------------
last_slot = -1;      // previous slot chosen by a trigger (-1 = none yet)
chosen_slot = -1;    // result of select_slot()

// Derived values (recomputed whenever sliders change)
thr = 10 ^ (slider1 / 20);
thr_low = thr * 10 ^ (-slider5 / 20);
attack_coef = exp(-1 / (srate * slider2 / 1000));
release_coef = exp(-1 / (srate * slider3 / 1000));
holdoff_samples = slider4 / 1000 * srate;
led_coef = exp(-1 / (srate * 0.2));     // ~200 ms LED hold
pk_coef = exp(-1 / (srate * 0.15));       // ~150 ms peak-follower decay
peak_window = (srate * 0.025) | 0;        // ~25 ms per-voice peak tracking
out_gain = 10 ^ (slider8 / 20);

// Transport fade: ramp the voice output up/down over ~5 ms on stop/play so
// the host's hard stop becomes a smooth fade instead of a click.
play_gain = 1;
fade_coef = exp(-1 / (srate * 0.005));
prev_play_state = 0;
stop_fading = 0;

// Store a loaded file's path into the matching named string slot.
function set_path(idx, path) (
  idx == 0 ? strcpy(#path0, path) :
  idx == 1 ? strcpy(#path1, path) :
  idx == 2 ? strcpy(#path2, path) :
  idx == 3 ? strcpy(#path3, path) :
  idx == 4 ? strcpy(#path4, path) :
  idx == 5 ? strcpy(#path5, path) :
  idx == 6 ? strcpy(#path6, path) :
             strcpy(#path7, path);
);

// Clear one slot (metadata + stored path).
function clear_slot(idx) (
  s_ok[idx] = 0;
  s_len[idx] = 0;
  s_nch[idx] = 0;
  s_rate[idx] = 0;
  s_err[idx] = 0;
  idx == 0 ? strcpy(#path0, "") :
  idx == 1 ? strcpy(#path1, "") :
  idx == 2 ? strcpy(#path2, "") :
  idx == 3 ? strcpy(#path3, "") :
  idx == 4 ? strcpy(#path4, "") :
  idx == 5 ? strcpy(#path5, "") :
  idx == 6 ? strcpy(#path6, "") :
             strcpy(#path7, "");
);

// Clear every slot.
function clear_all() local(i) (
  i = 0;
  loop(SLOTS, ( clear_slot(i); i += 1; ));
);

// Index of the first empty slot, or SLOTS if all are full.
function first_empty() local(i) (
  i = 0;
  while (i < SLOTS && s_ok[i]) ( i += 1; );
  i;
);

// Choose the next slot according to slider7 (selection mode).
// Writes the result to the global chosen_slot (-1 = nothing to play).
//   slider7 0 = Single (slot 1), 1 = Round-robin, 2 = Random (no repeat)
function select_slot() local(i, j, n, k, r, c) (
  chosen_slot = -1;

  // count loaded slots
  n = 0; i = 0;
  loop(SLOTS, ( s_ok[i] ? (n += 1); i += 1; ));

  n == 0 ? (
    chosen_slot = -1;
  ) : n == 1 ? (
    // exactly one loaded slot: always use it
    i = 0;
    while (i < SLOTS && !s_ok[i]) ( i += 1; );
    chosen_slot = i;
  ) : slider7 == 0 ? (
    // Single: slot 1 (top-left) if loaded
    chosen_slot = s_ok[0] ? 0 : -1;
  ) : slider7 == 1 ? (
    // Round-robin: first loaded slot strictly after last_slot, wrapping
    j = 1;
    loop(SLOTS, (
      i = last_slot + j;
      i >= SLOTS ? ( i -= SLOTS; );
      (chosen_slot < 0 && s_ok[i]) ? ( chosen_slot = i; );
      j += 1;
    ));
  ) : (
    // Random: uniform pick among loaded slots, excluding last_slot
    k = 0; i = 0;
    loop(SLOTS, ( (s_ok[i] && i != last_slot) ? (k += 1); i += 1; ));
    r = (rand(k)) | 0;
    r >= k ? ( r = k - 1; );
    c = 0; i = 0;
    loop(SLOTS, (
      (s_ok[i] && i != last_slot) ? (
        c += 1;
        (chosen_slot < 0 && c == r + 1) ? ( chosen_slot = i; );
      );
      i += 1;
    ));
  );
);

// Put a short display name (basename, max 22 chars) of slot idx into #disp.
function slot_disp(idx) local(len, k, c, done, p) (
  idx == 0 ? strcpy(#disp, #path0) :
  idx == 1 ? strcpy(#disp, #path1) :
  idx == 2 ? strcpy(#disp, #path2) :
  idx == 3 ? strcpy(#disp, #path3) :
  idx == 4 ? strcpy(#disp, #path4) :
  idx == 5 ? strcpy(#disp, #path5) :
  idx == 6 ? strcpy(#disp, #path6) :
             strcpy(#disp, #path7);
  len = strlen(#disp);
  k = 0; done = 0; p = -1;
  while (k < len && !done) (
    c = str_getchar(#disp, -(k+1));
    (c == 47 || c == 92) ? ( p = len - k; done = 1; );
    k += 1;
  );
  p > 0 ? ( strcpy_substr(#tmpname, #disp, p, -1); strcpy(#disp, #tmpname); );
  strlen(#disp) > 22 ? str_setlen(#disp, 22);
);

// Load a WAV/OGG file into slot idx. Resamples to the project rate.
// Must not be called from @sample (does file I/O).
function load_slot(idx, path) local(fh, nch, sr, avail, frames, cap, base) (
  base = AUDIO_BASE + idx*SLOT_STRIDE;
  s_ok[idx] = 0;
  s_err[idx] = 0;
  s_len[idx] = 0;
  s_nch[idx] = 0;
  s_rate[idx] = 0;

  fh = file_open(path);
  fh < 0 ? (
    s_err[idx] = 1;
  ) : (
    // 'rqsr' asks file_riff to resample to sr (REAPER 6.29+).
    // After the call, nch is the real channel count (1 or 2) on success.
    nch = 'rqsr';
    sr = srate;
    file_riff(fh, nch, sr);
    (nch == 1 || nch == 2) ? (
      avail = file_avail(fh);
      frames = (avail / nch) | 0;
      cap = (MAXLEN_SEC * srate) | 0;
      frames > cap ? frames = cap;
      frames > 0 ? (
        file_mem(fh, base, frames*nch);
        s_len[idx] = frames;
        s_nch[idx] = nch;
        s_rate[idx] = sr;
        s_ok[idx] = 1;
      ) : (
        s_err[idx] = 1;
      );
    ) : (
      s_err[idx] = 1;
    );
    file_close(fh);
  );
);

// Soft-clip a sample value into [-1, 1] so the summed voices can never push
// the output above full scale. Identity below 0.9, smoothly limited above.
function softclip(x) local(a) (
  a = abs(x);
  a <= 0.9 ? x : sign(x) * (0.9 + 0.1 * (1 - exp(-(a - 0.9) / 0.1)));
);

// Start a voice playing the given slot at the current trigger velocity.
// Grabs a free voice, or steals the oldest one when the pool is full.
function start_voice(slot) local(i, vfree, oldest) (
  vfree = -1;
  i = 0;
  while (i < VOICES && vfree < 0) (
    !v_active[i] ? ( vfree = i; );
    i += 1;
  );
  vfree < 0 ? (
    oldest = 0;
    i = 1;
    while (i < VOICES) (
      v_age[i] < v_age[oldest] ? ( oldest = i; );
      i += 1;
    );
    vfree = oldest;
  );
  v_active[vfree] = 1;
  v_pos[vfree] = 0;
  v_gain[vfree] = trig_vel;
  v_slot[vfree] = slot;
  v_peak[vfree] = pk;              // seed with the peak found so far
  v_track[vfree] = peak_window;    // keep refining for ~25 ms
  voice_age += 1;
  v_age[vfree] = voice_age;
);

@slider

thr = 10 ^ (slider1 / 20);
thr_low = thr * 10 ^ (-slider5 / 20);
attack_coef = exp(-1 / (srate * slider2 / 1000));
release_coef = exp(-1 / (srate * slider3 / 1000));
holdoff_samples = slider4 / 1000 * srate;
pk_coef = exp(-1 / (srate * 0.15));       // ~150 ms peak-follower decay
peak_window = (srate * 0.025) | 0;        // ~25 ms per-voice peak tracking
out_gain = 10 ^ (slider8 / 20);
fade_coef = exp(-1 / (srate * 0.005));

@sample

// --- keep the dry input for the wet/dry mix ---
dry_l = spl0;
dry_r = spl1;

// --- input peak (max of both channels) ---
in = abs(spl0);
in = max(in, abs(spl1));

// --- envelope follower: fast attack, slow release ---
coef = (in > env) ? attack_coef : release_coef;
env = coef * env + (1 - coef) * in;

// --- holdoff countdown ---
holdoff_counter > 0 ? (holdoff_counter -= 1);

// --- peak follower for velocity: the largest input excursion of this hit ---
pk = max(in, pk * pk_coef);

// --- re-arm once the smoothed envelope falls below the lower threshold ---
// NOTE: onset/derivative detection is planned for later, which would decouple
// retriggering from the envelope release time. For now, hysteresis + a short
// release keeps single hits from double-firing while allowing fast retriggers.
// Re-arming also resets the velocity peak so each hit is measured on its own.
env < thr_low ? (armed = 1; pk = 0; );

// --- fire a trigger? ---
trigger = 0;
(env >= thr) && armed && (holdoff_counter <= 0) ? (
  trigger = 1;
  armed = 0;
  holdoff_counter = holdoff_samples;
  trigger_count += 1;
  // velocity = the hit's peak seen so far, NOT the threshold-crossing level
  trig_vel = min(pk, 1);
  // choose the next sample and start a voice for it
  select_slot();
  chosen_slot >= 0 ? (
    start_voice(chosen_slot);
    last_slot = chosen_slot;
  );
);

// --- hold the LED ---
led = max(led * led_coef, trigger);

// --- polyphonic voice playback (accumulate voice output separately) ---
vosl = 0;
vosr = 0;
vi = 0;
loop(VOICES, (
  v_active[vi] ? (
    // keep refining this voice's velocity from the input peak for a short time
    v_track[vi] > 0 ? (
      v_peak[vi] = max(v_peak[vi], in);
      v_gain[vi] = min(v_peak[vi], 1);
      v_track[vi] -= 1;
    );
    s_ok[v_slot[vi]] ? (
      sbase = AUDIO_BASE + v_slot[vi]*SLOT_STRIDE;
      spos = v_pos[vi] | 0;
      snch = s_nch[v_slot[vi]];
      snch == 1 ? (
        vsmp = sbase[spos];
        vosl += vsmp * v_gain[vi];
        vosr += vsmp * v_gain[vi];
        v_pos[vi] += 1;
      ) : (
        vsmpL = sbase[spos*2];
        vsmpR = sbase[spos*2 + 1];
        vosl += vsmpL * v_gain[vi];
        vosr += vsmpR * v_gain[vi];
        v_pos[vi] += 1;
      );
      v_pos[vi] >= s_len[v_slot[vi]] ? ( v_active[vi] = 0; );
    ) : (
      // slot was unloaded mid-voice: stop immediately
      v_active[vi] = 0;
    );
  );
  vi += 1;
));

// --- transport-stop fade: on the 1 -> 0 transition, ramp voices down ---
// (0 = stopped, 1 = playing, 2 = paused, 5/6 = recording states)
stop_now = (play_state == 0) && (prev_play_state != 0);
prev_play_state = play_state;
stop_now ? ( stop_fading = 1; );
(play_state != 0) ? ( stop_fading = 0; );

play_target = stop_fading ? 0 : 1;
play_gain = fade_coef * play_gain + (1 - fade_coef) * play_target;

// once fully faded, drop the voices and end the fade so later live hits sound
(stop_fading && play_gain < 0.001) ? (
  vi = 0;
  loop(VOICES, ( v_active[vi] = 0; vi += 1; ));
  stop_fading = 0;
);

// --- linear wet/dry mix (coeffs sum to 1, so the blend stays within full scale) ---
wet = slider6;
spl0 = (1 - wet) * dry_l + wet * softclip(vosl * play_gain * out_gain);
spl1 = (1 - wet) * dry_r + wet * softclip(vosr * play_gain * out_gain);

@serialize

// Detect read mode (loading a project) vs write mode (saving one).
reading = file_avail(0) >= 0;

// @serialize may run before @init, so make sure the layout is ready.
setup_geometry();

file_string(0, #path0);
file_string(0, #path1);
file_string(0, #path2);
file_string(0, #path3);
file_string(0, #path4);
file_string(0, #path5);
file_string(0, #path6);
file_string(0, #path7);

// On load, re-open any saved samples so slots survive project reloads.
reading ? (
  strlen(#path0) > 0 ? load_slot(0, #path0);
  strlen(#path1) > 0 ? load_slot(1, #path1);
  strlen(#path2) > 0 ? load_slot(2, #path2);
  strlen(#path3) > 0 ? load_slot(3, #path3);
  strlen(#path4) > 0 ? load_slot(4, #path4);
  strlen(#path5) > 0 ? load_slot(5, #path5);
  strlen(#path6) > 0 ? load_slot(6, #path6);
  strlen(#path7) > 0 ? load_slot(7, #path7);
);

@gfx 720 460

// ---- mouse button edge detection ----
lmb = mouse_cap & 1;
rmb = mouse_cap & 2;
lclick = lmb && !(prev_cap & 1);
rclick = rmb && !(prev_cap & 2);
prev_cap = mouse_cap;

// ---- background ----
gfx_clear = 1;
gfx_setfont(1, "Arial", 14);
gfx_set(236/255, 236/255, 236/255, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

// ---- slot grid layout ----
pad = 10;
gap = 8;
cols = 4;
rows = 2;
top_h = 108;
gx = pad;
gy = top_h + pad;
gw = gfx_w - pad*2;
gh = gfx_h - gy - pad;
cw = (gw - (cols-1)*gap) / cols;
ch = (gh - (rows-1)*gap) / rows;

// ---- hover / x-button hit testing ----
hover = -1;
xbtn = -1;
i = 0;
loop(SLOTS, (
  col = i - (((i/cols) | 0) * cols);
  row = (i/cols) | 0;
  x = gx + col*(cw+gap);
  y = gy + row*(ch+gap);
  inside = (mouse_x >= x && mouse_x < x+cw && mouse_y >= y && mouse_y < y+ch);
  inside ? (hover = i);
  (inside && s_ok[i] && mouse_x >= x+cw-24 && mouse_x < x+cw-4 && mouse_y >= y+4 && mouse_y < y+24)
    ? (xbtn = i);
  i += 1;
));

// ---- Clear All button hit testing ----
ca_x = gfx_w - 112;
ca_y = 10;
ca_w = 102;
ca_h = 26;
over_ca = (mouse_x >= ca_x && mouse_x < ca_x+ca_w && mouse_y >= ca_y && mouse_y < ca_y+ca_h);

// ---- handle dropped files ----
n = 0;
while (gfx_getdropfile(n, #dropfile)) (
  t = hover >= 0 ? (hover + n) : first_empty();
  t >= SLOTS ? t = SLOTS - 1;
  t < 0 ? t = 0;
  set_path(t, #dropfile);
  load_slot(t, #dropfile);
  n += 1;
);
n > 0 ? gfx_getdropfile(-1);

// ---- handle unload clicks ----
lclick && over_ca ? clear_all();
lclick && xbtn >= 0 ? clear_slot(xbtn);
rclick && hover >= 0 ? clear_slot(hover);

// ---- header ----
gfx_setfont(1, "Arial", 18);
gfx_set(0.12, 0.12, 0.14, 1);
gfx_x = 12; gfx_y = 12;
gfx_drawstr("Triggve beta1");

gfx_setfont(1, "Arial", 14);
gfx_set(0.35, 0.35, 0.38, 1);
gfx_x = 12; gfx_y = 42;
gfx_drawstr("Drop a WAV onto a slot. Right-click or click x to unload.");

// selection mode + last slot
slider7 == 0 ? strcpy(#selname, "Single (slot 1)") :
slider7 == 1 ? strcpy(#selname, "Round-robin") :
                strcpy(#selname, "Random (no repeat)");
last_slot < 0 ? strcpy(#lastname, "-") : sprintf(#lastname, "%d", last_slot+1);
sprintf(#buf, "Mode: %s    Last slot: %s", #selname, #lastname);
gfx_set(0.05, 0.30, 0.60, 1);
gfx_x = 12; gfx_y = 66;
gfx_drawstr(#buf);

loaded = 0;
voices_active = 0;
i = 0;
loop(SLOTS, ( s_ok[i] ? (loaded += 1); i += 1; ));
i = 0;
loop(VOICES, ( v_active[i] ? (voices_active += 1); i += 1; ));

gfx_set(0.35, 0.35, 0.38, 1);
gfx_x = 12; gfx_y = 88;
gfx_printf("Slots: %d/%d loaded    Triggers: %d    Voices: %d/%d",
           loaded, SLOTS, trigger_count, voices_active, VOICES);

// ---- Clear All button ----
gfx_set(0.86, 0.86, 0.88, 1);
gfx_rect(ca_x, ca_y, ca_w, ca_h);
gfx_set(over_ca ? 0.05 : 0.25, over_ca ? 0.05 : 0.25, over_ca ? 0.07 : 0.28, 1);
gfx_x = ca_x + 14; gfx_y = ca_y + 5;
gfx_drawstr("Clear All");

// ---- slot grid ----
i = 0;
loop(SLOTS, (
  col = i - (((i/cols) | 0) * cols);
  row = (i/cols) | 0;
  x = gx + col*(cw+gap);
  y = gy + row*(ch+gap);

  // background tint
  s_ok[i] ? gfx_set(0.82, 0.92, 0.84, 1) :
  s_err[i] ? gfx_set(0.95, 0.84, 0.84, 1) :
             gfx_set(0.894, 0.894, 0.902, 1);
  gfx_rect(x, y, cw, ch);

  // border (bright blue when hovered)
  hover == i ? gfx_set(0.10, 0.45, 0.85, 1) : gfx_set(0.72, 0.72, 0.75, 1);
  gfx_rect(x, y, cw, 1);
  gfx_rect(x, y+ch-1, cw, 1);
  gfx_rect(x, y, 1, ch);
  gfx_rect(x+cw-1, y, 1, ch);

  // slot number + marker (larger font for readability)
  gfx_setfont(1, "Arial", 16);
  gfx_set(0.30, 0.32, 0.36, 1);
  gfx_x = x + 8; gfx_y = y + 6;
  gfx_printf("%d", i+1);

  // mark the active slot: PLAY in Single mode, LAST for the most recent pick
  #marker = "";
  slider7 == 0 ? (
    (i == 0 && s_ok[0]) ? ( #marker = "PLAY"; );
  ) : (
    (i == last_slot) ? ( #marker = "LAST"; );
  );
  strlen(#marker) ? (
    gfx_set(0.80, 0.50, 0.05, 1);
    gfx_x = x + 32; gfx_y = y + 6;
    gfx_drawstr(#marker);
  );

  s_ok[i] ? (
    // loaded indicator (green dot)
    gfx_set(0.10, 0.60, 0.25, 1);
    gfx_rect(x+cw-42, y+8, 10, 10);
    // x (unload) button
    gfx_set(0.82, 0.82, 0.85, 1);
    gfx_rect(x+cw-24, y+4, 20, 20);
    gfx_set(0.25, 0.25, 0.30, 1);
    gfx_x = x+cw-18; gfx_y = y+6;
    gfx_drawstr("x");
    // file name
    slot_disp(i);
    gfx_set(0.10, 0.10, 0.12, 1);
    gfx_x = x+8; gfx_y = y+34;
    gfx_drawstr(#disp);
    // details
    gfx_set(0.20, 0.42, 0.34, 1);
    gfx_x = x+8; gfx_y = y+60;
    gfx_printf("%.2fs  %dch  %dHz", s_len[i]/s_rate[i], s_nch[i], s_rate[i]);
  ) : (
    s_err[i] ? (
      gfx_set(0.65, 0.10, 0.10, 1);
      gfx_x = x+8; gfx_y = y+34;
      gfx_drawstr("load error");
    ) : (
      gfx_set(0.50, 0.52, 0.55, 1);
      gfx_x = x+8; gfx_y = y+34;
      gfx_drawstr("drop sample here");
    );
  );

  i += 1;
));
